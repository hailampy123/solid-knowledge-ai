# Provider keys — set the one matching your model. Only the chosen provider's
# key is required (none needed for `pytest`).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM routed through LiteLLM. Use an alias or any full LiteLLM id.
# Aliases: haiku | sonnet | gemini-flash | gemini-pro | gpt-4o | gpt-4o-mini
# Full ids: anthropic/… | openai/gpt-4o | gemini/gemini-2.5-pro | ollama/llama3 …
# Default is haiku (fast/cheap). Opus is intentionally blocked.
SKAI_MODEL=haiku

# Optional generation knobs (blank => provider default), any provider:
# SKAI_TEMPERATURE=0.0
# SKAI_MAX_TOKENS=1024
# SKAI_TOP_P=1.0
# Custom endpoint (Azure / OpenAI-compatible proxy / Ollama / vLLM). When set,
# the provider-key check is skipped.
# SKAI_API_BASE=http://localhost:11434

# Optional: DeepEval judge model (defaults to SKAI_MODEL). A stronger judge
# grades more reliably. e.g. SKAI_JUDGE_MODEL=sonnet
# SKAI_JUDGE_MODEL=sonnet

# Guardrails. Redaction + injection scan are on by default; refusal topics off.
# SKAI_PII_REDACTION=true          # redact PII/secrets on ingest and on output
# SKAI_INJECTION_SCAN=true         # quarantine prompt-injection chunks at ingest
# SKAI_REFUSAL_TOPICS=             # comma list of denied topics, e.g. "medical advice,legal advice"

# Optional: enable Langfuse tracing. Leave blank to disable (tracing no-ops).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
