# Required for real answers (skai ask / chat / eval). Not needed for `pytest`.
ANTHROPIC_API_KEY=

# LLM routed through LiteLLM. Use an alias (haiku | sonnet) or a full LiteLLM id.
# Default is haiku (fast/cheap). Opus is intentionally blocked.
SKAI_MODEL=haiku

# Optional: enable Langfuse tracing. Leave blank to disable (tracing no-ops).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
