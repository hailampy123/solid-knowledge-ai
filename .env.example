# Required for real answers (skai ask / chat / eval). Not needed for `pytest`.
ANTHROPIC_API_KEY=

# LLM model routed through LiteLLM. Any LiteLLM-supported id works.
SKAI_MODEL=anthropic/claude-3-5-sonnet-latest

# Optional: enable Langfuse tracing. Leave blank to disable (tracing no-ops).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
