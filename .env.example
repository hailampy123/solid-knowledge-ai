# Required for real answers (skai ask / chat / eval). Not needed for `pytest`.
ANTHROPIC_API_KEY=

# LLM routed through LiteLLM. Use an alias (haiku | sonnet) or a full LiteLLM id.
# Default is haiku (fast/cheap). Opus is intentionally blocked.
SKAI_MODEL=haiku

# Optional: DeepEval judge model (defaults to SKAI_MODEL). A stronger judge
# grades more reliably. e.g. SKAI_JUDGE_MODEL=sonnet
# SKAI_JUDGE_MODEL=sonnet

# Guardrails. Redaction + injection scan are on by default; refusal topics off.
# SKAI_PII_REDACTION=true          # redact PII/secrets on ingest and on output
# SKAI_INJECTION_SCAN=true         # quarantine prompt-injection chunks at ingest
# SKAI_REFUSAL_TOPICS=             # comma list of denied topics, e.g. "medical advice,legal advice"

# Optional: enable Langfuse tracing. Leave blank to disable (tracing no-ops).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
